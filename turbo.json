{
    "$schema": "https://v2-11-7.turborepo.dev/schema.json",
    "ui": "tui",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build",
                "db#generate",
                "check-types"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                ".env*",
                {
                    "mode": "dependencyOutputs",
                    "from": [
                        "db#generate"
                    ],
                    "globs": [
                        "generated/prisma/**"
                    ]
                }
            ],
            "outputs": [
                "dist/**",
                ".next/**",
                "!.next/cache/**",
                "!.next/dev/**"
            ]
        },
        "db#generate": {
            "outputs": [
                "generated/prisma/**"
            ]
        },
        "start": {
            "dependsOn": [
                "build"
            ],
            "cache": false,
            "persistent": true
        },
        "lint": {
            "dependsOn": [
                "^lint"
            ]
        },
        "check-types": {
            "dependsOn": [
                "^check-types",
                "db#generate"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "test": {
            "cache": false,
            "dependsOn": [
                "db#test:setup"
            ],
            "outputs": []
        },
        "test:setup": {
            "cache": false,
            "outputs": []
        }
    }
}
